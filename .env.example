# ─────────────────────────────────────────────────────────────────────────────
# DaeTrym web — variables de entorno
#
# Copia este archivo a `.env.local` y ajusta los valores. NUNCA subas `.env*`
# con secretos al repositorio (solo este `.env.example`).
# Se validan con Zod en src/env.ts: en producción, faltar una obligatoria
# rompe la build.
#
# Solo las que empiezan por NEXT_PUBLIC_ llegan al navegador. El resto son
# secretos del servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Fase 1 · Sitio ───────────────────────────────────────────────────────────

# URL pública canónica (sin barra final). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de contacto mostrado en el sitio y usado como destino de avisos. Obligatoria en producción.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Email para reportes de vulnerabilidades (security.txt y /security). Opcional:
# si falta se usa NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_SECURITY_EMAIL=

# WhatsApp: solo dígitos con prefijo de país, sin "+". Vacío = oculta el botón flotante.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL de agenda (Cal.com u otra). Vacío = el CTA "Agendar llamada" lleva a /contacto.
NEXT_PUBLIC_CAL_URL=

# Modo mantenimiento: "true" sirve la página de mantenimiento (503) en todo el sitio.
MAINTENANCE_MODE=false

# Salta la validación (solo CI/Docker donde no hay variables reales). Nunca en producción.
# SKIP_ENV_VALIDATION=1

# ── Fase 4 · Backend ──────────────────────────────────────────────────────────
# Todas estas son opcionales fuera de producción: sin ellas, `pnpm dev`/`pnpm test`/`pnpm build`
# funcionan igual con valores seguros de desarrollo (base de datos embebida, emails en consola, sin
# límite de envíos, Turnstile con la clave de pruebas de Cloudflare). Ver docs/ARCHITECTURE.md §14.

# Neon (integración de Vercel Marketplace). Sin ella, la base es Postgres embebido en memoria
# (@electric-sql/pglite): funciona igual, pero no persiste entre reinicios del servidor.
# DATABASE_URL=

# ≥ 32 caracteres aleatorios: `openssl rand -base64 32`. Firma el hash de la IP guardada y los
# tokens de descarga/baja del newsletter. Obligatoria (con un valor propio) en producción.
# IP_HASH_SECRET=

# Clave de la API de Resend. Sin ella, los emails se registran en consola en vez de enviarse.
# RESEND_API_KEY=

# Remitente con dominio verificado en Resend. Obligatoria en producción si se quiere enviar de verdad.
# EMAIL_FROM=

# Upstash Redis, REST (integración de Vercel Marketplace). Sin ambas, no hay límite de envíos.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Turnstile (challenges.cloudflare.com). Sin ellas fuera de producción, se usan las claves de PRUEBA
# públicas de Cloudflare (siempre aprueban): el widget real se carga y se verifica en servidor sin
# cuenta. Obligatorias (con claves reales) en producción.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ≥ 16 caracteres aleatorios. Protege /api/cron/retention (cabecera `Authorization: Bearer <esto>`,
# la pone Vercel Cron automáticamente si esta variable está configurada en el proyecto).
# CRON_SECRET=

# ── Fase 5 · Analítica ────────────────────────────────────────────────────────
# Sin cookies (Umami recomendado, D3; Plausible también vale — ver components/seo/analytics.tsx).
# Opcionales: sin las dos, no se carga ningún script de analítica.

# URL completa del script (p. ej. https://tu-instancia-umami.example/script.js).
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# Identificador del sitio en Umami (UUID); en Plausible sería el dominio.
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
