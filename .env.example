# ─────────────────────────────────────────────────────────────────────────────
# DaeTrym web — variables de entorno
#
# Copia este archivo a `.env.local` y ajusta los valores. NUNCA subas `.env*`
# con secretos al repositorio (solo este `.env.example`).
# Se validan con Zod en src/env.ts: en producción, faltar una obligatoria
# rompe la build.
#
# Solo las que empiezan por NEXT_PUBLIC_ llegan al navegador. El resto son
# secretos del servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Fase 1 · Sitio ───────────────────────────────────────────────────────────

# URL pública canónica (sin barra final). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de contacto mostrado en el sitio y usado como destino de avisos. Obligatoria en producción.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Email para reportes de vulnerabilidades (security.txt y /security). Opcional:
# si falta se usa NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_SECURITY_EMAIL=

# WhatsApp: solo dígitos con prefijo de país, sin "+". Vacío = oculta el botón flotante.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL de agenda (Cal.com u otra). Vacío = el CTA "Agendar llamada" lleva a /contacto.
NEXT_PUBLIC_CAL_URL=

# Modo mantenimiento: "true" sirve la página de mantenimiento (503) en todo el sitio.
MAINTENANCE_MODE=false

# Salta la validación (solo CI/Docker donde no hay variables reales). Nunca en producción.
# SKIP_ENV_VALIDATION=1

# ── Fase 4 · Backend (aún no se usan) ────────────────────────────────────────
# DATABASE_URL=            # Neon (integración de Vercel Marketplace)
# IP_HASH_SECRET=          # ≥ 32 caracteres aleatorios: `openssl rand -base64 32`
# RESEND_API_KEY=
# EMAIL_FROM=              # Remitente con dominio verificado en Resend
# UPSTASH_REDIS_REST_URL=  # Upstash (integración de Vercel Marketplace)
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CRON_SECRET=             # Protege la ruta de retención de datos

# ── Fase 5 · Analítica (aún no se usa) ───────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
